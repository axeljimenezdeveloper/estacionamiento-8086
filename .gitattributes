# ==========================================
# Política de finales de línea
# ==========================================

* text=auto

# Archivos que deben usar LF (Unix)
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# MASM 5.x (DOS) requiere CRLF en los .asm
*.asm text eol=crlf

# Scripts de Windows que deben usar CRLF
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Archivos binarios (no tocar)
*.exe binary
*.obj binary
*.com binary
*.lst binary
*.map binary